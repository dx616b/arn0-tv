{
  "name": "arn0-tv-launcher",
  "version": "0.8.0",
  "private": true,
  "description": "Minimal remote-friendly launcher for a Samsung Tizen TV",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/serve.mjs",
    "build": "sh scripts/build.sh",
    "build:local": "sh scripts/build.sh local",
    "test": "node --test test/*.test.mjs",
    "devlog": "node scripts/devlog-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
